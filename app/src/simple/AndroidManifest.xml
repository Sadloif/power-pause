<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
    <!-- Simple has no managed policy or alarm entry points. Its Accessibility
         service evaluates wall-clock membership when the exact menu appears. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" tools:node="remove" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" tools:node="remove" />
    <application>
        <receiver android:name=".admin.ShutdownProtectionAdminReceiver" tools:node="remove" />
        <receiver android:name=".admin.LockTaskPolicyUpdateReceiver" tools:node="remove" />
        <receiver android:name=".scheduling.ProtectionAlarmReceiver" tools:node="remove" />
        <receiver android:name=".scheduling.SystemEventReceiver" tools:node="remove" />
    </application>
</manifest>
